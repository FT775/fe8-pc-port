000*98
001*2      # 1500: A: the slot list (on slot 3)
000*148
040*2      # 1650: Up, slot 2
000*98
040*2      # 1750: Up, slot 1
000*98
001*2      # 1850: A, slot 1: 'Suspended data will be lost'
000*148
020*2      # 2000: Left, Start
000*98
001*2      # 2100: A, confirm
